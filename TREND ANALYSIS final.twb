            </map>
            <map to='#e15759'>
              <bucket>&quot;Delayed&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:TrafficConditions:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Normal&quot;</bucket>
            </map>
            <map to='#e15759'>
