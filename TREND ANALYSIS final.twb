      <aliases enabled='yes' />
      <column caption='Cost Efficiency' datatype='real' name='[Calculation_-9029154243892281343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[TransportCost] / [Quantity]' />
      </column>
      <column caption='Delay Analysis' datatype='string' name='[Calculation_-9029154243892473856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [HistoricalDelay] = &quot;No Delay&quot; THEN &quot;No Delay&quot;&#13;&#10;ELSEIF [HistoricalDelay] = &quot;1 Hour&quot; THEN &quot;1 Hour&quot;&#13;&#10;ELSEIF [HistoricalDelay] = &quot;2 Hours&quot; THEN &quot;2 Hours&quot;&#13;&#10;ELSE &quot;3+ Hours&quot;&#13;&#10;END' />
