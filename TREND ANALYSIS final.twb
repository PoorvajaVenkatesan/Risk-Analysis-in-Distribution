      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[yr:DispatchDate:ok]' type='palette'>
            <map to='#4e79a7'>
              <bucket>2023</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>2024</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[max:DeliveryStatus:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;On-Time&quot;</bucket>
